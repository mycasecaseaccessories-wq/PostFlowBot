# Telegram Bot API token from BotFather
BOT_TOKEN=

# Telegram API credentials from https://my.telegram.org
API_ID=
API_HASH=

# Telethon session name or path. Never commit generated .session files.
TELEGRAM_SESSION=

# One or more Telegram user IDs, separated by commas
ADMIN_USER_IDS=

# SQLite is the Phase 0 default; the SQLAlchemy URL can later point to PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./data/reposter.db
LOG_LEVEL=INFO
TIMEZONE=UTC