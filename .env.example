# PostFlow Bot — Telegram Admin Bot
BOT_TOKEN=

# Telegram User Account / Telethon credentials from https://my.telegram.org
API_ID=
API_HASH=

# Telethon session name or file path. Never commit generated .session files.
TELEGRAM_SESSION=

# One or more Telegram user IDs, separated by commas
ADMIN_USER_IDS=

# SQLite is the Phase 0 default; the SQLAlchemy URL can later point to PostgreSQL.
DATABASE_URL=sqlite+aiosqlite:///./data/postflow.db
# bootstrap creates metadata for local setup; migrations expects Alembic-upgraded schema.
DATABASE_SCHEMA_MODE=bootstrap
LOG_LEVEL=INFO
TIMEZONE=UTC
# Media files are stored under this directory. Mount a persistent volume here in hosting.
MEDIA_STORAGE_DIR=./data/media
# Maximum downloaded Telegram media size (50 MiB default).
MEDIA_MAX_BYTES=52428800

# Retry pending media on a bounded interval; after this many failures it is marked failed.
MEDIA_RETRY_MAX_ATTEMPTS=5
MEDIA_RETRY_INTERVAL_MINUTES=10
